[Unit]
Description=Aurora local Granite repository maintainer
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aurora-agy maintain /etc/aurora/maintenance.json
Restart=on-failure
RestartSec=15s
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
Nice=10
CPUWeight=25
IOWeight=25
TasksMax=512
MemoryHigh=16G
MemoryMax=24G
NoNewPrivileges=true
Environment=GIT_TERMINAL_PROMPT=0
Environment=CARGO_BUILD_JOBS=4

[Install]
WantedBy=multi-user.target
